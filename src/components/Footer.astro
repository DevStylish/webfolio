---
import { withBase } from "../consts";
const today = new Date();
---

<footer>
  <p class="copy">&copy; {today.getFullYear()} Moisés (DevStylish) Martín Pérez</p>
  <nav class="links" aria-label="Enlaces de pie de página">
    <a href={withBase('/')}>Inicio</a>
    <span aria-hidden="true">·</span>
    <a href={withBase('/blog')}>Blog</a>
    <span aria-hidden="true">·</span>
    <a href={withBase('/about')}>Sobre mí</a>
    <span aria-hidden="true">·</span>
    <a href={withBase('/rss.xml')}>RSS</a>
    <span aria-hidden="true">·</span>
    <a href="https://github.com/DevStylish" target="_blank" rel="noopener">GitHub</a>
    <span aria-hidden="true">·</span>
    <a
      href="https://www.linkedin.com/in/mois%C3%A9s-mart%C3%ADn-p%C3%A9rez-601430189/"
      target="_blank"
      rel="noopener"
    >LinkedIn</a
    >
  </nav>
  <p class="made">Hecho con Astro 🚀 · <a href="#top">Volver arriba ↑</a></p>
</footer>
<style>
  footer {
    margin-top: 3em;
    padding: 1.4em 1em;
    border-top: 1px solid rgb(var(--gray-light));
    color: rgb(var(--gray));
    font-size: 0.85em;
    text-align: center;
  }
  footer p {
    margin: 0.25em 0;
  }
  .links {
    margin: 0.25em 0;
  }
  footer a {
    color: rgb(var(--gray-dark));
    text-decoration: none;
  }
  footer a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
