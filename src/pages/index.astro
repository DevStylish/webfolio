---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts[0];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`${SITE_TITLE} — Ingeniero de Software Java | Portfolio y Blog`}
      description={SITE_DESCRIPTION}
    />
    <style>
      .hero {
        padding: 3em 2em;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(var(--gray-light), 0.7), rgba(var(--gray-light), 0.25));
        border: 1px solid rgb(var(--gray-light));
        text-align: center;
      }
      .availability {
        display: inline-block;
        font-size: 0.85em;
        font-weight: 700;
        padding: 0.3em 1em;
        border-radius: 999px;
        background: rgba(34, 197, 94, 0.15);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.4);
        margin-bottom: 1em;
      }
      :global([data-theme='dark']) .availability {
        color: #4ade80;
      }
      .hero h1 {
        font-size: 2.6em;
        margin: 0 0 0.2em 0;
      }
      .hero .role {
        font-size: 1.25em;
        color: var(--accent);
        font-weight: 700;
        margin: 0 0 0.6em 0;
      }
      .hero p {
        text-align: center;
        max-width: 58ch;
        margin: 0 auto;
      }
      .hero-cta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.7em;
        margin-top: 1.5em;
      }
      .hero-cta a {
        padding: 0.6em 1.6em;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid var(--accent);
      }
      .hero-cta a.primary {
        background: var(--accent);
        color: #fff;
      }
      .hero-cta a:not(.primary) {
        color: var(--accent);
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1em;
        margin: 2em 0;
      }
      .stat {
        background: rgba(var(--gray-light), 0.35);
        border: 1px solid rgb(var(--gray-light));
        border-radius: 14px;
        padding: 1em 0.5em;
        text-align: center;
      }
      .stat strong {
        display: block;
        font-size: 1.9em;
        line-height: 1.1;
        color: var(--accent);
      }
      .stat span {
        font-size: 0.85em;
        color: rgb(var(--gray));
      }
      .section {
        margin: 2.5em 0;
      }
      .section h2 {
        margin-bottom: 0.4em;
      }
      .section > p {
        color: rgb(var(--gray-dark));
      }
      .cards {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1em;
        margin-top: 1em;
      }
      .card {
        display: block;
        padding: 1.3em 1.4em;
        border-radius: 16px;
        background: rgba(var(--gray-light), 0.35);
        border: 1px solid rgb(var(--gray-light));
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--box-shadow);
      }
      .card h3 {
        margin: 0 0 0.3em 0;
      }
      .card p {
        margin: 0;
        font-size: 0.95em;
        color: rgb(var(--gray));
      }
      .card .go {
        display: inline-block;
        margin-top: 0.7em;
        font-weight: 700;
        color: var(--accent);
      }
      .latest {
        display: block;
        margin-top: 1em;
        border-radius: 16px;
        overflow: hidden;
        background: rgba(var(--gray-light), 0.35);
        border: 1px solid rgb(var(--gray-light));
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .latest:hover {
        transform: translateY(-4px);
        box-shadow: var(--box-shadow);
      }
      .latest img {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
      }
      .latest-body {
        padding: 1.3em 1.5em;
      }
      .latest-body h3 {
        margin: 0 0 0.3em 0;
        color: rgb(var(--black));
      }
      .latest:hover h3 {
        color: var(--accent);
      }
      .latest-body p {
        margin: 0.3em 0;
        color: rgb(var(--gray));
      }
      .latest-body .date {
        font-size: 0.85em;
      }
      .nick {
        font-size: 0.95em;
        color: rgb(var(--gray));
      }
      @media (max-width: 720px) {
        .hero {
          padding: 2em 1.2em;
        }
        .hero h1 {
          font-size: 1.9em;
        }
        .stats {
          grid-template-columns: 1fr;
        }
        .cards {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <Header title={SITE_TITLE} />
    <main>
      <section class="hero">
        <span class="availability">🟢 Disponible para nuevos retos · Sevilla</span>
        <h1>¡Hola! Soy Moisés 👋</h1>
        <p class="role">Ingeniero de Software · Backend Java @ NTT DATA</p>
        <p>
          +5 años construyendo aplicaciones empresariales, APIs REST y modernizando
          sistemas legacy. En esta web comparto lo que aprendo y muestro quién soy
          más allá del código.
        </p>
        <div class="hero-cta">
          <a class="primary" href="/about">Conóceme</a>
          <a href="/blog">Leer el blog</a>
        </div>
      </section>

      <div class="stats">
        <div class="stat"><strong>+5</strong><span>años trabajando</span></div>
        <div class="stat"><strong>6</strong><span>empresas</span></div>
        <div class="stat"><strong>{posts.length}</strong><span>{posts.length === 1 ? 'post publicado' : 'posts publicados'}</span></div>
      </div>

      <section class="section">
        <h2>¿Qué es un "webfolio"? 🤔</h2>
        <p>
          Fácil: la mezcla entre una <strong>web</strong> y un <strong>portfolio</strong>.
          Pero no uno cualquiera — ¿en qué portfolio se suele escribir sobre lo que se va
          aprendiendo? Mi idea es mostrar mi formación como desarrollador "todoterreno"
          (fullstack) y usar esta web como bloc de apuntes para quien lo necesite.
        </p>
        <p class="nick">
          💡 El nombre: en Steam, Epic y demás uso el nick "Stylish". Como soy
          desarrollador, le puse "Dev" delante → <strong>DevStylish</strong>.
        </p>
      </section>

      <section class="section">
        <h2>Explora la web 🧭</h2>
        <div class="cards">
          <a class="card" href="/about">
            <h3>👨🏻‍💻 Sobre mí</h3>
            <p>Experiencia en NTT DATA, Oxigent y más. Formación, capacidades y proyectos.</p>
            <span class="go">Ver perfil →</span>
          </a>
          <a class="card" href="/blog">
            <h3>✍️ Blog</h3>
            <p>Java, Astro, Kotlin y opiniones del sector. Apuntes reales del día a día.</p>
            <span class="go">Leer posts →</span>
          </a>
        </div>
      </section>

      {latest && (
        <section class="section">
          <h2>Última publicación ✨</h2>
          <a class="latest" href={`/blog/${latest.slug}/`}>
            <img
              width={720}
              height={260}
              src={latest.data.heroImage}
              alt={latest.data.title}
              loading="lazy"
              decoding="async"
            />
            <div class="latest-body">
              <h3>{latest.data.title}</h3>
              <p>{latest.data.description}</p>
              <p class="date"><FormattedDate date={latest.data.pubDate} /></p>
            </div>
          </a>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>
